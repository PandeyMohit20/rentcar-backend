'use strict';

const { Router } = require('express');
const { authenticate } = require('../../middlewares/authenticate');
const { authorize } = require('../../middlewares/authorize');
const { validate } = require('../../middlewares/validate');
const { WalletController } = require('./controller');

const {
  transactionsQuerySchema,
  createTopupSchema,
  verifyTopupSchema,
  adminWalletListSchema,
  adminUserIdSchema,
  adminWalletMutationSchema,
} = require('./validator');

const router = Router();

/* ============================================================
 * ADMIN WALLET ROUTES
 * ============================================================ */

/*
 * List all wallets.
 * Permission: wallet.view
 */
router.get(
  '/admin',
  authenticate,
  authorize('wallet.view'),
  validate({
    query: adminWalletListSchema,
  }),
  WalletController.listAdminWallets,
);

/*
 * Get wallet for a specific user.
 * Permission: wallet.view
 */
router.get(
  '/admin/:userId',
  authenticate,
  authorize('wallet.view'),
  validate({
    params: adminUserIdSchema,
  }),
  WalletController.getAdminWallet,
);

/*
 * Get wallet transactions for a specific user.
 * Permission: wallet.view
 */
router.get(
  '/admin/:userId/transactions',
  authenticate,
  authorize('wallet.view'),
  validate({
    params: adminUserIdSchema,
    query: transactionsQuerySchema,
  }),
  WalletController.listAdminTransactions,
);

/*
 * Credit user's wallet.
 * Permission: wallet.transact
 */
router.post(
  '/admin/:userId/credit',
  authenticate,
  authorize('wallet.transact'),
  validate({
    params: adminUserIdSchema,
    body: adminWalletMutationSchema,
  }),
  WalletController.adminCreditWallet,
);

/*
 * Debit user's wallet.
 * Permission: wallet.transact
 */
router.post(
  '/admin/:userId/debit',
  authenticate,
  authorize('wallet.transact'),
  validate({
    params: adminUserIdSchema,
    body: adminWalletMutationSchema,
  }),
  WalletController.adminDebitWallet,
);

/* ============================================================
 * CUSTOMER WALLET ROUTES
 * ============================================================ */

router.get(
  '/',
  authenticate,
  WalletController.getWallet,
);

router.get(
  '/transactions',
  authenticate,
  validate({
    query: transactionsQuerySchema,
  }),
  WalletController.listTransactions,
);

router.post(
  '/topups',
  authenticate,
  validate({
    body: createTopupSchema,
  }),
  WalletController.createTopup,
);

router.post(
  '/topups/verify',
  authenticate,
  validate({
    body: verifyTopupSchema,
  }),
  WalletController.verifyTopup,
);

module.exports = {
  walletRouter: router,
};