'use strict';

const { WalletService } = require('./service');
const { success } = require('../../utils/response');

const WalletController = {
  /* ==========================================================
   * CUSTOMER WALLET
   * ========================================================== */

  async getWallet(req, res, next) {
    try {
      const wallet = await WalletService.getWallet(
        req.user.sub,
      );

      return success(res, {
        message: 'Wallet fetched successfully',
        data: {
          wallet,
        },
      });
    } catch (err) {
      return next(err);
    }
  },

  async listTransactions(req, res, next) {
    try {
      const result =
        await WalletService.listTransactions(
          req.user.sub,
          req.query,
        );

      return success(res, {
        message:
          'Wallet transactions fetched successfully',
        data: {
          items: result.items,
        },
        meta: result.meta,
      });
    } catch (err) {
      return next(err);
    }
  },

  /* ==========================================================
   * CUSTOMER TOP-UP
   * ========================================================== */

  async createTopup(req, res, next) {
    try {
      const result =
        await WalletService.createTopup(
          req.user.sub,
          req.body.amount,
        );

      return success(res, {
        statusCode: 201,
        message:
          'Wallet top-up order created successfully.',
        data: result,
      });
    } catch (error) {
      return next(error);
    }
  },

  async verifyTopup(req, res, next) {
    try {
      const result =
        await WalletService.verifyTopup(
          req.user.sub,
          req.body,
        );

      return success(res, {
        message: result.replayed
          ? 'Wallet top-up already processed.'
          : 'Wallet top-up completed successfully.',
        data: result,
      });
    } catch (error) {
      return next(error);
    }
  },

  /* ==========================================================
   * ADMIN WALLET
   * ========================================================== */

  /**
   * GET /wallet/admin
   *
   * Lists all user wallets.
   */
  async listAdminWallets(req, res, next) {
    try {
      const result =
        await WalletService.listAdminWallets(
          req.query,
        );

      return success(res, {
        message:
          'Admin wallets fetched successfully.',
        data: {
          items: result.items,
        },
        meta: result.meta,
      });
    } catch (error) {
      return next(error);
    }
  },

  /**
   * GET /wallet/admin/:userId
   *
   * Gets wallet + user information.
   */
  async getAdminWallet(req, res, next) {
    try {
      const result =
        await WalletService.getAdminWallet(
          req.params.userId,
        );

      return success(res, {
        message:
          'Wallet details fetched successfully.',
        data: result,
      });
    } catch (error) {
      return next(error);
    }
  },

  /**
   * GET /wallet/admin/:userId/transactions
   *
   * Lists transactions for a user's wallet.
   */
  async listAdminTransactions(req, res, next) {
    try {
      const result =
        await WalletService.listAdminTransactions(
          req.params.userId,
          req.query,
        );

      return success(res, {
        message:
          'Wallet transactions fetched successfully.',
        data: {
          items: result.items,
        },
        meta: result.meta,
      });
    } catch (error) {
      return next(error);
    }
  },

  /**
   * POST /wallet/admin/:userId/credit
   *
   * Credits user's wallet.
   */
  async adminCreditWallet(req, res, next) {
    try {
      const result =
        await WalletService.adminCreditWallet(
          req.params.userId,
          req.body,
        );

      return success(res, {
        statusCode: result.replayed
          ? 200
          : 201,
        message: result.replayed
          ? 'Wallet credit already processed.'
          : 'Wallet credited successfully.',
        data: result,
      });
    } catch (error) {
      return next(error);
    }
  },

  /**
   * POST /wallet/admin/:userId/debit
   *
   * Debits user's wallet.
   */
  async adminDebitWallet(req, res, next) {
    try {
      const result =
        await WalletService.adminDebitWallet(
          req.params.userId,
          req.body,
        );

      return success(res, {
        statusCode: result.replayed
          ? 200
          : 201,
        message: result.replayed
          ? 'Wallet debit already processed.'
          : 'Wallet debited successfully.',
        data: result,
      });
    } catch (error) {
      return next(error);
    }
  },
};

module.exports = {
  WalletController,
};