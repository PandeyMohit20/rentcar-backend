'use strict';

const ReportsRepository = require('./repository');
const { SUCCESSFUL_PAYMENT_STATUSES, SUCCESSFUL_REFUND_STATUSES } = require('./constants');

function money(value) {
  if (value === null || value === undefined) {
    return 0;
  }

  if (typeof value === 'object' && typeof value.toNumber === 'function') {
    return value.toNumber();
  }

  const number = Number(value);

  return Number.isFinite(number) ? number : 0;
}

function roundMoney(value) {
  return Math.round((value + Number.EPSILON) * 100) / 100;
}

function paymentCountsAsCollected(payment) {
  return SUCCESSFUL_PAYMENT_STATUSES.includes(payment.status);
}

function refundCountsAsRefunded(refund) {
  return SUCCESSFUL_REFUND_STATUSES.includes(refund.status);
}

function calculateBookingFinancials(booking) {
  let grossCollected = 0;
  let refundedAmount = 0;

  for (const payment of booking.payments || []) {
    if (paymentCountsAsCollected(payment)) {
      grossCollected += money(payment.amount);
    }

    for (const refund of payment.refunds || []) {
      if (refundCountsAsRefunded(refund)) {
        refundedAmount += money(refund.amount);
      }
    }
  }

  grossCollected = roundMoney(grossCollected);
  refundedAmount = roundMoney(refundedAmount);

  return {
    grossCollected,
    refundedAmount,
    netCollected: roundMoney(grossCollected - refundedAmount),
  };
}

function incrementMap(map, key, values) {
  if (!map.has(key)) {
    map.set(key, { ...values });
    return map.get(key);
  }

  return map.get(key);
}

function buildReport(bookings, filters) {
  const statusCounts = new Map();
  const paymentMethodMap = new Map();
  const trendMap = new Map();
  const vendorMap = new Map();
  const branchMap = new Map();
  const carMap = new Map();

  let grossCollected = 0;
  let refundedAmount = 0;

  const rows = bookings.map((booking) => {
    const financials = calculateBookingFinancials(booking);

    grossCollected += financials.grossCollected;
    refundedAmount += financials.refundedAmount;

    statusCounts.set(booking.status, (statusCounts.get(booking.status) || 0) + 1);

    for (const payment of booking.payments || []) {
      if (paymentCountsAsCollected(payment)) {
        const method = payment.paymentMethod || 'unknown';

        const methodRow = incrementMap(paymentMethodMap, method, {
          method,
          count: 0,
          amount: 0,
        });

        methodRow.count += 1;
        methodRow.amount = roundMoney(methodRow.amount + money(payment.amount));

        const eventDate = payment.paidAt || payment.createdAt;

        if (eventDate) {
          const date = new Date(eventDate).toISOString().slice(0, 10);

          const trend = incrementMap(trendMap, date, {
            date,
            grossCollected: 0,
            refundedAmount: 0,
            netCollected: 0,
          });

          trend.grossCollected = roundMoney(trend.grossCollected + money(payment.amount));
        }
      }

      for (const refund of payment.refunds || []) {
        if (!refundCountsAsRefunded(refund)) {
          continue;
        }

        const eventDate = refund.processedAt || refund.createdAt;

        if (!eventDate) {
          continue;
        }

        const date = new Date(eventDate).toISOString().slice(0, 10);

        const trend = incrementMap(trendMap, date, {
          date,
          grossCollected: 0,
          refundedAmount: 0,
          netCollected: 0,
        });

        trend.refundedAmount = roundMoney(trend.refundedAmount + money(refund.amount));
      }
    }

    const vendorName = booking.vendor?.companyName || booking.vendor?.legalName || 'Unknown Vendor';

    if (booking.vendor?.id) {
      const vendor = incrementMap(vendorMap, booking.vendor.id, {
        vendorId: booking.vendor.id,
        vendorName,
        bookings: 0,
        grossCollected: 0,
        refundedAmount: 0,
        netCollected: 0,
      });

      vendor.bookings += 1;
      vendor.grossCollected = roundMoney(vendor.grossCollected + financials.grossCollected);
      vendor.refundedAmount = roundMoney(vendor.refundedAmount + financials.refundedAmount);
      vendor.netCollected = roundMoney(vendor.grossCollected - vendor.refundedAmount);
    }

    const branch = booking.car?.branch;

    if (branch?.id) {
      const branchRow = incrementMap(branchMap, branch.id, {
        branchId: branch.id,
        branchName: branch.name,
        city: branch.city,
        bookings: 0,
        grossCollected: 0,
        refundedAmount: 0,
        netCollected: 0,
      });

      branchRow.bookings += 1;
      branchRow.grossCollected = roundMoney(branchRow.grossCollected + financials.grossCollected);
      branchRow.refundedAmount = roundMoney(branchRow.refundedAmount + financials.refundedAmount);
      branchRow.netCollected = roundMoney(branchRow.grossCollected - branchRow.refundedAmount);
    }

    if (booking.car?.id) {
      const carName = [booking.car.brand, booking.car.model].filter(Boolean).join(' ');

      const car = incrementMap(carMap, booking.car.id, {
        carId: booking.car.id,
        carName,
        registrationNumber: booking.car.registrationNumber,
        bookings: 0,
        grossCollected: 0,
        refundedAmount: 0,
        netCollected: 0,
      });

      car.bookings += 1;
      car.grossCollected = roundMoney(car.grossCollected + financials.grossCollected);
      car.refundedAmount = roundMoney(car.refundedAmount + financials.refundedAmount);
      car.netCollected = roundMoney(car.grossCollected - car.refundedAmount);
    }

    return {
      bookingId: booking.id,
      bookingNumber: booking.bookingNumber,

      createdAt: booking.createdAt,
      startAt: booking.startAt,
      endAt: booking.endAt,

      bookingStatus: booking.status,
      paymentStatus: booking.paymentStatus,

      customer: booking.customer
        ? {
            id: booking.customer.id,
            name: booking.customer.name,
            email: booking.customer.email,
          }
        : null,

      vendor: booking.vendor
        ? {
            id: booking.vendor.id,
            name: vendorName,
          }
        : null,

      branch: branch
        ? {
            id: branch.id,
            name: branch.name,
            city: branch.city,
          }
        : null,

      car: booking.car
        ? {
            id: booking.car.id,
            name: [booking.car.brand, booking.car.model].filter(Boolean).join(' '),
            registrationNumber: booking.car.registrationNumber,
          }
        : null,

      subtotal: money(booking.subtotal),
      tax: money(booking.tax),
      discount: money(booking.discount),
      securityDeposit: money(booking.securityDeposit),
      totalAmount: money(booking.totalAmount),

      ...financials,

      currencyCode: booking.currencyCode || 'INR',
    };
  });

  const collectionTrend = Array.from(trendMap.values())
    .map((row) => ({
      ...row,
      netCollected: roundMoney(row.grossCollected - row.refundedAmount),
    }))
    .sort((a, b) => a.date.localeCompare(b.date));

  grossCollected = roundMoney(grossCollected);
  refundedAmount = roundMoney(refundedAmount);

  const netCollected = roundMoney(grossCollected - refundedAmount);

  const paidBookings = rows.filter((row) => row.grossCollected > 0).length;

  return {
    filters,
    currencyCode: 'INR',

    kpis: {
      totalBookings: bookings.length,

      confirmedBookings: statusCounts.get('CONFIRMED') || 0,

      activeBookings: statusCounts.get('ACTIVE') || 0,

      completedBookings: statusCounts.get('COMPLETED') || 0,

      cancelledBookings: statusCounts.get('CANCELLED') || 0,

      grossCollected,
      refundedAmount,
      netCollected,

      averagePaidBookingValue: paidBookings > 0 ? roundMoney(grossCollected / paidBookings) : 0,
    },

    bookingStatus: Array.from(statusCounts.entries())
      .map(([status, count]) => ({
        status,
        count,
      }))
      .sort((a, b) => a.status.localeCompare(b.status)),

    paymentMethods: Array.from(paymentMethodMap.values()).sort((a, b) => b.amount - a.amount),

    collectionTrend,

    vendors: Array.from(vendorMap.values()).sort((a, b) => b.netCollected - a.netCollected),

    branches: Array.from(branchMap.values()).sort((a, b) => b.netCollected - a.netCollected),

    cars: Array.from(carMap.values()).sort((a, b) => b.netCollected - a.netCollected),

    rows,

    generatedAt: new Date().toISOString(),
  };
}

async function getReport(filters = {}) {
  const bookings = await ReportsRepository.findReportBookings(filters);

  return buildReport(bookings, filters);
}

module.exports = {
  getReport,
  buildReport,
  calculateBookingFinancials,
};
