// ============================================================
// BOOKINGS & TRIPS
// ============================================================

model Booking {
  financialSnapshot  Json?             @map("financial_snapshot")
  billingSnapshot    Json?             @map("billing_snapshot")
  id                 String            @id @default(uuid()) @db.VarChar(36)
  bookingNumber      String            @unique @map("booking_number") @db.VarChar(50)
  userId             String            @map("user_id") @db.VarChar(36) // customer
  vendorId           String            @map("vendor_id") @db.VarChar(36)
  carId              String            @map("car_id") @db.VarChar(36)
  pickupLocationId   String?           @map("pickup_location_id") @db.VarChar(36)
  dropoffLocationId  String?           @map("dropoff_location_id") @db.VarChar(36)
  startAt            DateTime          @map("start_at")
  endAt              DateTime          @map("end_at")
  subtotal           Decimal           @db.Decimal(12, 2)
  tax                Decimal?          @default(0) @db.Decimal(12, 2)
  discount           Decimal?          @default(0) @db.Decimal(12, 2)
  securityDeposit    Decimal?          @default(0) @map("security_deposit") @db.Decimal(12, 2)
  totalAmount        Decimal           @map("total_amount") @db.Decimal(12, 2)
  currencyCode       String            @default("INR") @map("currency_code") @db.VarChar(3)
  status             BookingStatusEnum @default(PENDING)
  paymentStatus      PaymentStatusEnum @default(pending) @map("payment_status")
  vendorCommision    Decimal?          @default(0) @map("vendor_commision") @db.Decimal(12, 2)
  holdExpiresAt      DateTime?         @map("hold_expires_at")
  cancelledAt        DateTime?         @map("cancelled_at")
  cancellationReason String?           @map("cancellation_reason") @db.VarChar(500)
  idempotencyKey     String?           @map("idempotency_key") @db.VarChar(255)
  idempotencyHash    String?           @map("idempotency_hash") @db.VarChar(64)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  user          User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  vendor        Vendor                 @relation("VendorBookings", fields: [vendorId], references: [id], onDelete: Restrict)
  car           Car                    @relation(fields: [carId], references: [id], onDelete: Restrict)
  items         BookingItem[]
  payments      Payment[]
  refunds       Refund[]
  invoices      Invoice[]
  trips         TripHistory[]
  extensions    TripExtension[]
  couponUsages  CouponUsage[]
  reviews       Review[]
  statusHistory BookingStatusHistory[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([carId])
  @@index([vendorId])
  @@index([status])
  @@index([paymentStatus])
  @@index([startAt])
  @@index([endAt])
  @@index([pickupLocationId])
  @@index([dropoffLocationId])
  @@index([holdExpiresAt])
  @@map("bookings")
}

model VendorMember {
  id        String   @id @default(uuid()) @db.VarChar(36)
  vendorId  String   @map("vendor_id") @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  isOwner   Boolean  @default(false) @map("is_owner")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([vendorId, userId])
  @@index([userId])
  @@index([vendorId, isOwner])
  @@map("vendor_members")
}

model UserDocument {
  id              String               @id @default(uuid()) @db.VarChar(36)
  userId          String               @map("user_id") @db.VarChar(36)
  documentType    UserDocumentTypeEnum @map("document_type")
  storageKey      String               @map("storage_key") @db.VarChar(500)
  status          DocumentStatusEnum   @default(pending)
  issuedAt        DateTime?            @map("issued_at")
  expiresAt       DateTime?            @map("expires_at")
  remarks         String?              @db.VarChar(500)
  verifiedAt      DateTime?            @map("verified_at")
  verifiedBy      String?              @map("verified_by") @db.VarChar(36)
  rejectionReason String?              @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  user     User  @relation("UserDocuments", fields: [userId], references: [id], onDelete: Cascade)
  verifier User? @relation("UserDocumentVerifiedBy", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, documentType])
  @@index([status])
  @@map("user_documents")
}

model BookingItem {
  id           String   @id @default(uuid()) @db.VarChar(36)
  bookingId    String   @map("booking_id") @db.VarChar(36)
  carId        String   @map("car_id") @db.VarChar(36)
  itemType     String   @default("car") @map("item_type") @db.VarChar(50)
  quantity     Int      @default(1)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
  currencyCode String   @default("INR") @map("currency_code") @db.VarChar(3)
  subtotal     Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  car     Car     @relation(fields: [carId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([carId])
  @@map("booking_items")
}

model BookingStatusHistory {
  id         String             @id @default(uuid()) @db.VarChar(36)
  bookingId  String             @map("booking_id") @db.VarChar(36)
  fromStatus BookingStatusEnum? @map("from_status")
  toStatus   BookingStatusEnum  @map("to_status")
  changedBy  String?            @map("changed_by") @db.VarChar(36)
  reason     String?            @db.VarChar(500)
  createdAt  DateTime           @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([toStatus])
  @@map("booking_status_history")
}

model TripHistory {
  id             String     @id @default(uuid()) @db.VarChar(36)
  bookingId      String     @map("booking_id") @db.VarChar(36)
  startTime      DateTime?  @map("start_time")
  endTime        DateTime?  @map("end_time")
  startOdometer  Int?       @map("start_odometer")
  endOdometer    Int?       @map("end_odometer")
  startFuel      Decimal?   @map("start_fuel") @db.Decimal(6, 2)
  endFuel        Decimal?   @map("end_fuel") @db.Decimal(6, 2)
  distance       Decimal?   @db.Decimal(10, 2)
  actualDistance Int?       @map("actual_distance")
  startedBy      String?    @map("started_by") @db.VarChar(36)
  completedBy    String?    @map("completed_by") @db.VarChar(36)
  pickupNotes    String?    @map("pickup_notes") @db.VarChar(1000)
  returnNotes    String?    @map("return_notes") @db.VarChar(1000)
  tripStatus     StatusEnum @default(pending) @map("trip_status")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  booking         Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  startedByUser   User?        @relation("TripStartedBy", fields: [startedBy], references: [id], onDelete: SetNull)
  completedByUser User?        @relation("TripCompletedBy", fields: [completedBy], references: [id], onDelete: SetNull)
  photos          TripPhoto[]
  damages         TripDamage[]

  @@unique([bookingId])
  @@index([bookingId])
  @@map("trip_history")
}

model TripExtension {
  id               String     @id @default(uuid()) @db.VarChar(36)
  bookingId        String     @map("booking_id") @db.VarChar(36)
  requestedBy      String     @map("requested_by") @db.VarChar(36)
  oldEndTime       DateTime   @map("old_end_time")
  newEndTime       DateTime   @map("new_end_time")
  additionalAmount Decimal    @default(0) @map("additional_amount") @db.Decimal(12, 2)
  currencyCode     String     @default("INR") @map("currency_code") @db.VarChar(3)
  status           StatusEnum @default(pending)
  approvedBy       String?    @map("approved_by") @db.VarChar(36)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  booking         Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  requestedByUser User    @relation("ExtensionRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  approvedByUser  User?   @relation("ExtensionApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([requestedBy])
  @@index([status])
  @@map("trip_extensions")
}

model TripPhoto {
  id         String   @id @default(uuid()) @db.VarChar(36)
  tripId     String   @map("trip_id") @db.VarChar(36)
  photoType  String   @map("photo_type") @db.VarChar(50)
  imageUrl   String   @map("image_url") @db.VarChar(500)
  capturedAt DateTime @map("captured_at")
  uploadedBy String?  @map("uploaded_by") @db.VarChar(36)
  createdAt  DateTime @default(now()) @map("created_at")

  trip TripHistory @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_photos")
}

model TripDamage {
  id           String     @id @default(uuid()) @db.VarChar(36)
  tripId       String     @map("trip_id") @db.VarChar(36)
  damageType   String     @map("damage_type") @db.VarChar(100)
  description  String?    @db.VarChar(1000)
  amount       Decimal?   @db.Decimal(12, 2)
  currencyCode String     @default("INR") @map("currency_code") @db.VarChar(3)
  photoUrl     String?    @map("photo_url") @db.VarChar(500)
  status       StatusEnum @default(pending)
  reportedAt   DateTime   @default(now()) @map("reported_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  trip TripHistory @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([status])
  @@map("trip_damage")
}

// ============================================================
// FINANCIALS — PAYMENTS, REFUNDS, WALLETS, COUPONS, INVOICES
// ============================================================

model Payment {
  id                   String                       @id @default(uuid()) @db.VarChar(36)
  bookingId            String                       @map("booking_id") @db.VarChar(36)
  userId               String                       @map("user_id") @db.VarChar(36)
  amount               Decimal                      @db.Decimal(12, 2)
  currencyCode         String                       @default("INR") @map("currency_code") @db.VarChar(3)
  paymentMethod        PaymentMethodEnum            @default(card) @map("payment_method")
  provider             String?                      @db.VarChar(100)
  providerOrderId      String?                      @unique @map("provider_order_id") @db.VarChar(100)
  providerPaymentId    String?                      @unique @map("provider_payment_id") @db.VarChar(100)
  status               PaymentStatusEnum            @default(pending)
  operationalStatus    PaymentOperationalStatusEnum @default(normal) @map("operational_status")
  transactionReference String?                      @unique @map("transaction_reference") @db.VarChar(150)
  paidAt               DateTime?                    @map("paid_at")
  failedAt             DateTime?                    @map("failed_at")
  failureReason        String?                      @map("failure_reason") @db.VarChar(500)
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")

  booking       Booking               @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  refunds       Refund[]
  webhookEvents PaymentWebhookEvent[]

  @@index([bookingId])
  @@index([userId])
  @@index([status])
  @@index([paidAt])
  @@map("payments")
}

model PaymentWebhookEvent {
  id              String    @id @default(uuid()) @db.VarChar(36)
  provider        String    @db.VarChar(100)
  providerEventId String    @map("provider_event_id") @db.VarChar(150)
  eventType       String    @map("event_type") @db.VarChar(100)
  paymentId       String?   @map("payment_id") @db.VarChar(36)
  payloadHash     String?   @map("payload_hash") @db.VarChar(64)
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@index([createdAt])
  @@map("payment_webhook_events")
}

model Refund {
  id                String           @id @default(uuid()) @db.VarChar(36)
  paymentId         String           @map("payment_id") @db.VarChar(36)
  bookingId         String           @map("booking_id") @db.VarChar(36)
  amount            Decimal          @db.Decimal(12, 2)
  currencyCode      String           @default("INR") @map("currency_code") @db.VarChar(3)
  provider          String?          @db.VarChar(100)
  reason            String?          @db.VarChar(500)
  status            RefundStatusEnum @default(pending)
  providerReference String?          @unique @map("provider_reference") @db.VarChar(150)
  idempotencyKey    String?          @map("idempotency_key") @db.VarChar(255)
  processedAt       DateTime?        @map("processed_at")
  failedAt          DateTime?        @map("failed_at")
  failureReason     String?          @map("failure_reason") @db.VarChar(500)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  payment       Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  booking       Booking              @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  webhookEvents RefundWebhookEvent[]

  @@unique([bookingId, idempotencyKey])
  @@index([paymentId])
  @@index([bookingId])
  @@index([status])
  @@map("refunds")
}

model RefundWebhookEvent {
  id              String    @id @default(uuid()) @db.VarChar(36)
  provider        String    @db.VarChar(100)
  providerEventId String    @map("provider_event_id") @db.VarChar(150)
  eventType       String    @map("event_type") @db.VarChar(100)
  refundId        String?   @map("refund_id") @db.VarChar(36)
  payloadHash     String?   @map("payload_hash") @db.VarChar(64)
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  refund Refund? @relation(fields: [refundId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([refundId])
  @@index([createdAt])
  @@map("refund_webhook_events")
}

model Wallet {
  id           String           @id @default(uuid()) @db.VarChar(36)
  userId       String           @unique @map("user_id") @db.VarChar(36)
  balance      Decimal          @default(0) @db.Decimal(14, 2)
  currencyCode String           @default("INR") @map("currency_code") @db.VarChar(3)
  status       WalletStatusEnum @default(active)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id            String                    @id @default(uuid()) @db.VarChar(36)
  walletId      String                    @map("wallet_id") @db.VarChar(36)
  type          WalletTransactionTypeEnum @default(credit)
  amount        Decimal                   @db.Decimal(14, 2)
  balanceBefore Decimal                   @map("balance_before") @db.Decimal(14, 2)
  balanceAfter  Decimal                   @map("balance_after") @db.Decimal(14, 2)
  referenceType WalletReferenceTypeEnum   @map("reference_type")
  referenceId   String?                   @map("reference_id") @db.VarChar(36)
  description   String?                   @db.VarChar(500)
  createdAt     DateTime                  @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("wallet_transactions")
}

model Coupon {
  id                   String           @id @default(uuid()) @db.VarChar(36)
  code                 String           @unique @db.VarChar(50)
  discountType         DiscountTypeEnum @default(percentage) @map("discount_type")
  discountValue        Decimal          @map("discount_value") @db.Decimal(12, 2)
  minimumBookingAmount Decimal?         @map("minimum_booking_amount") @db.Decimal(12, 2)
  maximumDiscount      Decimal?         @map("maximum_discount") @db.Decimal(12, 2)
  startDate            DateTime?        @map("start_date")
  endDate              DateTime?        @map("end_date")
  usageLimit           Int?             @map("usage_limit")
  perUserLimit         Int?             @default(1) @map("per_user_limit")
  status               CouponStatusEnum @default(active)
  isDeleted            Boolean          @default(false) @map("is_deleted")
  deletedAt            DateTime?        @map("deleted_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  usages CouponUsage[]

  @@index([status])
  @@index([startDate, endDate])
  @@map("coupons")
}

model CouponUsage {
  id             String   @id @default(uuid()) @db.VarChar(36)
  couponId       String   @map("coupon_id") @db.VarChar(36)
  userId         String   @map("user_id") @db.VarChar(36)
  bookingId      String   @map("booking_id") @db.VarChar(36)
  discountAmount Decimal  @map("discount_amount") @db.Decimal(12, 2)
  usedAt         DateTime @default(now()) @map("used_at")

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([couponId, bookingId])
  @@index([userId])
  @@index([couponId, userId])
  @@map("coupon_usage")
}

model InvoiceSequence {
  fiscalYear Int @id @map("fiscal_year")
  nextNumber Int @default(0) @map("next_number")

  @@map("invoice_sequences")
}

model Invoice {
  snapshot      Json?
  id            String            @id @default(uuid()) @db.VarChar(36)
  invoiceNumber String            @unique @map("invoice_number") @db.VarChar(50)
  bookingId     String?           @map("booking_id") @db.VarChar(36)
  userId        String            @map("user_id") @db.VarChar(36)
  vendorId      String?           @map("vendor_id") @db.VarChar(36)
  subtotal      Decimal           @db.Decimal(12, 2)
  tax           Decimal           @default(0) @db.Decimal(12, 2)
  discount      Decimal           @default(0) @db.Decimal(12, 2)
  total         Decimal           @db.Decimal(12, 2)
  currencyCode  String            @default("INR") @map("currency_code") @db.VarChar(3)
  status        InvoiceStatusEnum @default(draft)
  invoiceDate   DateTime          @map("invoice_date")
  dueDate       DateTime?         @map("due_date")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  vendor  Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@unique([bookingId])
  @@index([bookingId])
  @@index([userId])
  @@index([vendorId])
  @@index([status])
  @@index([invoiceDate])
  @@map("invoices")
}

// ============================================================
// REVIEWS & RATINGS
// ============================================================

model Review {
  id        String           @id @default(uuid()) @db.VarChar(36)
  userId    String           @map("user_id") @db.VarChar(36)
  bookingId String?          @map("booking_id") @db.VarChar(36)
  carId     String           @map("car_id") @db.VarChar(36)
  rating    Int              @db.TinyInt
  comment   String?          @db.VarChar(2000)
  status    ReviewStatusEnum @default(pending)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  car     Car      @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([bookingId, carId])
  @@index([carId])
  @@index([status])
  @@map("reviews")
}

model RatingSummary {
  id        String   @id @default(uuid()) @db.VarChar(36)
  carId     String?  @unique @map("car_id") @db.VarChar(36)
  vendorId  String?  @unique @map("vendor_id") @db.VarChar(36)
  average   Decimal  @default(0) @db.Decimal(3, 2)
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([average])
  @@map("rating_summaries")
}

// ============================================================
// NOTIFICATIONS & SUPPORT
// ============================================================

model EmailDelivery {
  id                String   @id @default(uuid()) @db.VarChar(36)
  dedupeKey         String   @unique @map("dedupe_key") @db.VarChar(64)
  bookingId         String   @map("booking_id") @db.VarChar(36)
  eventType         String   @map("event_type") @db.VarChar(100)
  recipient         String   @db.VarChar(255)
  payload           Json
  status            String   @default("pending") @db.VarChar(30)
  attempts          Int      @default(0)
  nextAttemptAt     DateTime @default(now()) @map("next_attempt_at")
  claimedAt         DateTime? @map("claimed_at")
  acceptedAt        DateTime? @map("accepted_at")
  providerMessageId String?  @map("provider_message_id") @db.VarChar(255)
  lastErrorCode     String?  @map("last_error_code") @db.VarChar(100)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([bookingId])
  @@index([status, nextAttemptAt])
  @@map("email_deliveries")
}

model Notification {
  id        String                  @id @default(uuid()) @db.VarChar(36)
  userId    String                  @map("user_id") @db.VarChar(36)
  type      String                  @db.VarChar(100)
  title     String                  @db.VarChar(255)
  message   String                  @db.Text
  channel   NotificationChannelEnum @default(in_app)
  status    NotificationStatusEnum  @default(pending)
  readAt    DateTime?               @map("read_at")
  sentAt    DateTime?               @map("sent_at")
  createdAt DateTime                @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("notifications")
}

model SupportTicket {
  id           String             @id @default(uuid()) @db.VarChar(36)
  ticketNumber String             @unique @map("ticket_number") @db.VarChar(50)
  userId       String             @map("user_id") @db.VarChar(36)
  category     TicketCategoryEnum @default(support)
  priority     TicketPriorityEnum @default(medium)
  subject      String             @db.VarChar(255)
  description  String?            @db.Text
  status       TicketStatusEnum   @default(open)
  assignedTo   String?            @map("assigned_to") @db.VarChar(36)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  user     User             @relation("TicketReporter", fields: [userId], references: [id], onDelete: Restrict)
  assignee User?            @relation("TicketAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([userId])
  @@index([assignedTo])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([assignedTo, status])
  @@map("support_tickets")
}

model SupportMessage {
  id            String   @id @default(uuid()) @db.VarChar(36)
  ticketId      String   @map("ticket_id") @db.VarChar(36)
  senderId      String   @map("sender_id") @db.VarChar(36)
  message       String   @db.Text
  attachmentUrl String?  @map("attachment_url") @db.VarChar(500)
  isStaff       Boolean  @default(false) @map("is_staff")
  createdAt     DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@map("support_messages")
}

// ============================================================
// SYSTEM — SETTINGS, LOGS, REPORTS, ANALYTICS
// ============================================================

model Setting {
  id        String   @id @default(uuid()) @db.VarChar(36)
  key       String   @unique @db.VarChar(150)
  value     String   @db.Text
  type      String   @default("string") @db.VarChar(50)
  group     String?  @db.VarChar(100)
  isPublic  Boolean  @default(false) @map("is_public")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([group])
  @@map("settings")
}

model ActivityLog {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String?  @map("user_id") @db.VarChar(36)
  action    String   @db.VarChar(100)
  module    String   @db.VarChar(100)
  entity    String?  @db.VarChar(150)
  entityId  String?  @map("entity_id") @db.VarChar(36)
  metadata  String?  @db.Text // JSON string, non-relational optional context
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@index([entity, entityId])
  @@map("activity_logs")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String?  @map("user_id") @db.VarChar(36)
  action    String   @db.VarChar(100)
  module    String   @db.VarChar(100)
  entity    String?  @db.VarChar(150)
  entityId  String?  @map("entity_id") @db.VarChar(36)
  result    String?  @db.VarChar(50)
  metadata  String?  @db.Text // JSON string, optional
  requestId String?  @map("request_id") @db.VarChar(100)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@index([entity, entityId])
  @@index([requestId])
  @@map("audit_logs")
}

model Report {
  id            String     @id @default(uuid()) @db.VarChar(36)
  reportName    String     @map("report_name") @db.VarChar(150)
  reportType    String     @map("report_type") @db.VarChar(100)
  fromDate      DateTime?  @map("from_date")
  toDate        DateTime?  @map("to_date")
  status        StatusEnum @default(pending)
  statusMessage String?    @map("status_message") @db.VarChar(500)
  fileUrl       String?    @map("file_url") @db.VarChar(500)
  createdBy     String?    @map("created_by") @db.VarChar(36)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([reportType, fromDate, toDate])
  @@index([createdBy])
  @@index([status])
  @@map("reports")
}

model DailyMetric {
  id              String   @id @default(uuid()) @db.VarChar(36)
  metricDate      DateTime @unique @map("metric_date") @db.Date
  bookingsCount   Int      @default(0) @map("bookings_count")
  revenueAmount   Decimal  @default(0) @map("revenue_amount") @db.Decimal(16, 2)
  activeCars      Int      @default(0) @map("active_cars")
  totalTrips      Int      @default(0) @map("total_trips")
  totalDistance   Decimal  @default(0) @map("total_distance") @db.Decimal(12, 2)
  newCustomers    Int      @default(0) @map("new_customers")
  utilizationRate Decimal  @default(0) @map("utilization_rate") @db.Decimal(5, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([metricDate])
  @@map("daily_metrics")
}
