// ============================================================
// RentCar SaaS — Prisma Schema (Single Source of Truth)
// ------------------------------------------------------------
// Provider   : MySQL 8+
// ORM        : Prisma ORM / Prisma Client
// ID strategy: UUID v4 (String @id @default(uuid()) @db.VarChar(36))
// Money      : Decimal (never Float/Double)
// Timestamps : createdAt / updatedAt / deletedAt (UTC)
// ------------------------------------------------------------
// THIS FILE IS THE SOLE SOURCE OF TRUTH FOR THE DATABASE.
// BACKEND MUST CONSUME THE PRISMA CLIENT GENERATED FROM HERE.
// DO NOT CREATE A SEPARATE PRISMA SCHEMA IN rentcar-backend.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

// Generic master-entity lifecycle status
enum StatusEnum {
  active
  inactive
  pending
  suspended
  archived
  rejected
}

enum UserStatusEnum {
  active
  inactive
  pending
  suspended
  blocked
  deleted
}

enum VerificationStatusEnum {
  unverified
  pending
  verified
  rejected
}

enum RoleStatusEnum {
  active
  inactive
}

enum DocumentStatusEnum {
  pending
  verified
  rejected
  expired
}

enum UserDocumentTypeEnum {
  driving_license
  pan
  identity_proof
  address_proof
}

enum FuelTypeEnum {
  petrol
  diesel
  cng
  electric
  hybrid
  lpg
}

enum TransmissionEnum {
  automatic
  manual
}

enum CarStatusEnum {
  available
  booked
  busy
  maintenance
  inactive
  retired
}

enum AvailabilityStatusEnum {
  available
  unavailable
  maintenance
  blocked
}

enum BookingStatusEnum {
  PENDING
  CONFIRMED
  PAYMENT_PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
  REJECTED
}

enum PaymentStatusEnum {
  pending
  processing
  succeeded
  failed
  cancelled
  refunded
}

enum PaymentOperationalStatusEnum {
  normal
  review_required
  late_payment_conflict
}

enum PaymentMethodEnum {
  card
  upi
  net_banking
  wallet
  cash
  bank_transfer
  other
}

enum RefundStatusEnum {
  pending
  processing
  succeeded
  failed
  cancelled
}

enum WalletStatusEnum {
  active
  frozen
  closed
}

enum WalletTransactionTypeEnum {
  credit
  debit
}

enum WalletReferenceTypeEnum {
  booking
  refund
  topup
  payout
  adjustment
  commission
  cancellation
}

enum CouponStatusEnum {
  active
  inactive
  expired
  disabled
}

enum DiscountTypeEnum {
  percentage
  fixed
}

enum InvoiceStatusEnum {
  draft
  issued
  paid
  overdue
  void
  cancelled
}

enum ReviewStatusEnum {
  pending
  approved
  rejected
  hidden
}

enum NotificationChannelEnum {
  email
  sms
  push
  in_app
}

enum NotificationStatusEnum {
  pending
  sent
  delivered
  read
  failed
}

enum TicketPriorityEnum {
  low
  medium
  high
  urgent
}

enum TicketStatusEnum {
  open
  pending
  resolved
  closed
  reopened
}

enum TicketCategoryEnum {
  booking
  payment
  refund
  support
  technical
  other
}

enum GenderEnum {
  male
  female
  other
  undisclosed
}

enum RatingStatusEnum {
  pending
  published
  hidden
}

enum OtpPurposeEnum {
  registration
  login
  password_reset
  email_verification
  phone_verification
  delete_account
}

enum IpSourceEnum {
  mobile
  web
  admin
  system
}

// ============================================================
// CORE IDENTITY — USERS, ROLES, PERMISSIONS, AUTH
// ============================================================

model User {
  id              String         @id @default(uuid()) @db.VarChar(36)
  name            String         @db.VarChar(255)
  email           String         @unique @db.VarChar(255)
  phone           String?        @db.VarChar(50)
  passwordHash    String         @map("password_hash") @db.VarChar(255)
  status          UserStatusEnum @default(pending)
  emailVerifiedAt DateTime?      @map("email_verified_at")
  lastLoginAt     DateTime?      @map("last_login_at")
  isDeleted       Boolean        @default(false) @map("is_deleted")
  deletedAt       DateTime?      @map("deleted_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  profile                 Profile?         @relation("ProfileSubject")
  addresses               Address[]
  refreshTokens           RefreshToken[]
  sessions                Session[]
  otps                    Otp[]
  roles                   UserRole[]
  notifications           Notification[]
  supportTickets          SupportTicket[]  @relation("TicketReporter")
  assignedTickets         SupportTicket[]  @relation("TicketAssignee")
  activityLogs            ActivityLog[]
  auditLogs               AuditLog[]
  ratings                 Review[]
  tripsRequested          TripExtension[]  @relation("ExtensionRequester")
  tripsApproved           TripExtension[]  @relation("ExtensionApprover")
  wallet                  Wallet?
  bookings                Booking[]
  payments                Payment[]
  couponUsages            CouponUsage[]
  invoices                Invoice[]
  supportMessages         SupportMessage[]
  userDocuments           UserDocument[]   @relation("UserDocuments")
  verifiedUserDocuments   UserDocument[]   @relation("UserDocumentVerifiedBy")
  verifiedProfiles        Profile[]        @relation("ProfileVerifiedBy")
  verifiedVendors         Vendor[]         @relation("VendorVerifiedBy")
  verifiedVendorDocuments VendorDocument[] @relation("VendorDocumentVerifiedBy")
  vendorMemberships       VendorMember[]
  tripsStarted            TripHistory[]    @relation("TripStartedBy")
  tripsCompleted          TripHistory[]    @relation("TripCompletedBy")

  @@index([phone])
  @@index([status])
  @@index([emailVerifiedAt])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String         @id @default(uuid()) @db.VarChar(36)
  name        String         @unique @db.VarChar(100)
  description String?        @db.VarChar(500)
  isSystem    Boolean        @default(false) @map("is_system")
  isActive    Boolean        @default(true) @map("is_active")
  status      RoleStatusEnum @default(active)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @unique @db.VarChar(150)
  description String?  @db.VarChar(500)
  module      String   @db.VarChar(100)
  action      String   @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@unique([module, action])
  @@index([module])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  roleId    String   @map("role_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.VarChar(36)
  roleId       String   @map("role_id") @db.VarChar(36)
  permissionId String   @map("permission_id") @db.VarChar(36)
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @map("user_id") @db.VarChar(36)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Session {
  id               String        @id @default(uuid()) @db.VarChar(36)
  userId           String        @map("user_id") @db.VarChar(36)
  sessionTokenHash String        @unique @map("session_token_hash") @db.VarChar(255)
  expiresAt        DateTime      @map("expires_at")
  lastActiveAt     DateTime      @map("last_active_at")
  ipAddress        String?       @map("ip_address") @db.VarChar(45)
  userAgent        String?       @map("user_agent") @db.VarChar(500)
  deviceSource     IpSourceEnum? @map("device_source")
  createdAt        DateTime      @default(now()) @map("created_at")
  revokedAt        DateTime?     @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([lastActiveAt])
  @@map("sessions")
}

model Otp {
  id           String         @id @default(uuid()) @db.VarChar(36)
  userId       String         @map("user_id") @db.VarChar(36)
  purpose      OtpPurposeEnum @default(registration)
  codeHash     String         @map("code_hash") @db.VarChar(255)
  expiresAt    DateTime       @map("expires_at")
  verifiedAt   DateTime?      @map("verified_at")
  attemptCount Int            @default(0) @map("attempt_count")
  createdAt    DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("otp")
}

model Profile {
  id                 String                 @id @default(uuid()) @db.VarChar(36)
  userId             String                 @unique @map("user_id") @db.VarChar(36)
  dateOfBirth        DateTime?              @map("date_of_birth") @db.Date
  gender             GenderEnum?
  profileImage       String?                @map("profile_image") @db.VarChar(500)
  verificationStatus VerificationStatusEnum @default(unverified) @map("verification_status")
  submittedAt        DateTime?              @map("submitted_at")
  verifiedAt         DateTime?              @map("verified_at")
  verifiedBy         String?                @map("verified_by") @db.VarChar(36)
  rejectionReason    String?                @map("rejection_reason") @db.VarChar(500)
  bio                String?                @db.VarChar(1000)
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  user     User  @relation("ProfileSubject", fields: [userId], references: [id], onDelete: Cascade)
  verifier User? @relation("ProfileVerifiedBy", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@map("profiles")
}

model Address {
  id           String   @id @default(uuid()) @db.VarChar(36)
  userId       String   @map("user_id") @db.VarChar(36)
  addressLine1 String   @map("address_line1") @db.VarChar(255)
  addressLine2 String?  @map("address_line2") @db.VarChar(255)
  city         String   @db.VarChar(100)
  state        String?  @db.VarChar(100)
  country      String   @default("IN") @db.VarChar(2)
  postalCode   String?  @map("postal_code") @db.VarChar(20)
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  addressType  String   @default("home") @map("address_type") @db.VarChar(50)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([city])
  @@map("addresses")
}

// ============================================================
// VENDORS
// ============================================================

model Vendor {
  taxProfile         Json?                  @map("tax_profile")
  id                 String                 @id @default(uuid()) @db.VarChar(36)
  vendorCode         String                 @unique @map("vendor_code") @db.VarChar(50)
  companyName        String                 @map("company_name") @db.VarChar(255)
  legalName          String?                @map("legal_name") @db.VarChar(255)
  email              String?                @db.VarChar(255)
  phone              String?                @db.VarChar(50)
  website            String?                @db.VarChar(255)
  taxId              String?                @map("tax_id") @db.VarChar(100)
  gstin              String?                @db.VarChar(100)
  verificationStatus VerificationStatusEnum @default(pending) @map("verification_status")
  submittedAt        DateTime?              @map("submitted_at")
  verifiedAt         DateTime?              @map("verified_at")
  verifiedBy         String?                @map("verified_by") @db.VarChar(36)
  rejectionReason    String?                @map("rejection_reason") @db.VarChar(500)
  commissionRate     Decimal?               @default(10) @map("commission_rate") @db.Decimal(5, 2)
  status             StatusEnum             @default(pending)
  isDeleted          Boolean                @default(false) @map("is_deleted")
  deletedAt          DateTime?              @map("deleted_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  documents    VendorDocument[]
  bankAccounts VendorBankAccount[]
  cars         Car[]
  branches     Branch[]
  bookings     Booking[]           @relation("VendorBookings")
  invoices     Invoice[]
  locations    Location[]
  members      VendorMember[]
  verifier     User?               @relation("VendorVerifiedBy", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([verificationStatus])
  @@index([isDeleted])
  @@index([companyName])
  @@map("vendors")
}

model VendorDocument {
  id              String             @id @default(uuid()) @db.VarChar(36)
  vendorId        String             @map("vendor_id") @db.VarChar(36)
  documentType    String             @map("document_type") @db.VarChar(100)
  documentUrl     String             @map("document_url") @db.VarChar(500)
  status          DocumentStatusEnum @default(pending)
  issuedAt        DateTime?          @map("issued_at")
  expiresAt       DateTime?          @map("expires_at")
  remarks         String?            @db.VarChar(500)
  verifiedAt      DateTime?          @map("verified_at")
  verifiedBy      String?            @map("verified_by") @db.VarChar(36)
  rejectionReason String?            @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  verifier User?  @relation("VendorDocumentVerifiedBy", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@index([vendorId])
  @@index([status])
  @@map("vendor_documents")
}

model VendorBankAccount {
  id            String     @id @default(uuid()) @db.VarChar(36)
  vendorId      String     @map("vendor_id") @db.VarChar(36)
  accountHolder String     @map("account_holder") @db.VarChar(255)
  bankName      String     @map("bank_name") @db.VarChar(255)
  accountNumber String     @map("account_number") @db.VarChar(100)
  ifscCode      String?    @map("ifsc_code") @db.VarChar(50)
  swiftCode     String?    @map("swift_code") @db.VarChar(50)
  currencyCode  String     @default("INR") @map("currency_code") @db.VarChar(3)
  isDefault     Boolean    @default(false) @map("is_default")
  status        StatusEnum @default(active)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_bank_accounts")
}

// ============================================================
// GEOGRAPHY — CITIES, LOCATIONS, BRANCHES
// ============================================================

model City {
  id        String     @id @default(uuid()) @db.VarChar(36)
  name      String     @db.VarChar(100)
  state     String?    @db.VarChar(100)
  country   String     @default("IN") @db.VarChar(2)
  code      String?    @unique @db.VarChar(20)
  latitude  Decimal?   @db.Decimal(10, 7)
  longitude Decimal?   @db.Decimal(10, 7)
  status    StatusEnum @default(active)
  isDeleted Boolean    @default(false) @map("is_deleted")
  deletedAt DateTime?  @map("deleted_at")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  locations Location[]

  @@index([name, country])
  @@index([status])
  @@map("cities")
}

model Location {
  id           String     @id @default(uuid()) @db.VarChar(36)
  cityId       String     @map("city_id") @db.VarChar(36)
  vendorId     String     @map("vendor_id") @db.VarChar(36)
  name         String     @db.VarChar(255)
  address      String?    @db.VarChar(500)
  latitude     Decimal?   @db.Decimal(10, 7)
  longitude    Decimal?   @db.Decimal(10, 7)
  locationType String     @default("pickup") @map("location_type") @db.VarChar(50)
  status       StatusEnum @default(active)
  isDeleted    Boolean    @default(false) @map("is_deleted")
  deletedAt    DateTime?  @map("deleted_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  city     City     @relation(fields: [cityId], references: [id], onDelete: Restrict)
  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  branches Branch[]

  @@index([cityId])
  @@index([vendorId])
  @@index([status])
  @@index([latitude, longitude])
  @@map("locations")
}

model Branch {
  id            String     @id @default(uuid()) @db.VarChar(36)
  locationId    String     @map("location_id") @db.VarChar(36)
  vendorId      String     @map("vendor_id") @db.VarChar(36)
  name          String     @db.VarChar(255)
  address       String?    @db.VarChar(500)
  phone         String?    @db.VarChar(50)
  email         String?    @db.VarChar(255)
  city          String?    @db.VarChar(100)
  isOperational Boolean    @default(true) @map("is_operational")
  status        StatusEnum @default(active)
  isDeleted     Boolean    @default(false) @map("is_deleted")
  deletedAt     DateTime?  @map("deleted_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  cars     Car[]

  @@index([locationId])
  @@index([vendorId])
  @@index([isOperational])
  @@map("branches")
}

// ============================================================
// FLEET — CARS & RELATED
// ============================================================

model Car {
  id                 String           @id @default(uuid()) @db.VarChar(36)
  vendorId           String           @map("vendor_id") @db.VarChar(36)
  branchId           String           @map("branch_id") @db.VarChar(36)
  registrationNumber String           @unique @map("registration_number") @db.VarChar(50)
  vin                String?          @unique @db.VarChar(50)
  brand              String           @db.VarChar(100)
  model              String           @db.VarChar(100)
  variant            String?          @db.VarChar(150)
  manufacturingYear  Int              @map("manufacturing_year")
  fuelType           FuelTypeEnum?    @map("fuel_type")
  transmission       TransmissionEnum @default(manual)
  seatingCapacity    Int              @default(4) @map("seating_capacity")
  status             CarStatusEnum    @default(available)
  odometer           Int              @default(0)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  isDeleted          Boolean          @default(false) @map("is_deleted")
  deletedAt          DateTime?        @map("deleted_at")

  vendor         Vendor            @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  images         CarImage[]
  features       CarFeature[]
  pricings       CarPricing[]
  availabilities CarAvailability[]
  documents      CarDocument[]
  insurances     CarInsurance[]
  maintenance    Maintenance[]
  fuelLogs       FuelLog[]
  gpsDevices     GpsDevice[]
  bookings       Booking[]
  bookingItems   BookingItem[]
  reviews        Review[]

  @@index([vendorId])
  @@index([branchId])
  @@index([status])
  @@index([brand, model])
  @@index([manufacturingYear])
  @@index([isDeleted])
  @@map("cars")
}

model CarImage {
  id        String   @id @default(uuid()) @db.VarChar(36)
  carId     String   @map("car_id") @db.VarChar(36)
  imageUrl  String   @map("image_url") @db.VarChar(500)
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  altText   String?  @map("alt_text") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId])
  @@map("car_images")
}

model CarFeature {
  id      String  @id @default(uuid()) @db.VarChar(36)
  carId   String  @map("car_id") @db.VarChar(36)
  name    String  @db.VarChar(100)
  iconKey String? @map("icon_key") @db.VarChar(100)

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([carId, name])
  @@index([carId])
  @@map("car_features")
}

model CarPricing {
  id              String     @id @default(uuid()) @db.VarChar(36)
  carId           String     @map("car_id") @db.VarChar(36)
  hourlyPrice     Decimal?   @map("hourly_price") @db.Decimal(12, 2)
  dailyPrice      Decimal    @map("daily_price") @db.Decimal(12, 2)
  weeklyPrice     Decimal?   @map("weekly_price") @db.Decimal(12, 2)
  monthlyPrice    Decimal?   @map("monthly_price") @db.Decimal(12, 2)
  extraHourPrice  Decimal?   @map("extra_hour_price") @db.Decimal(12, 2)
  extraKmPrice    Decimal?   @map("extra_km_price") @db.Decimal(12, 2)
  securityDeposit Decimal?   @map("security_deposit") @db.Decimal(12, 2)
  currencyCode    String     @default("INR") @map("currency_code") @db.VarChar(3)
  effectiveFrom   DateTime?  @map("effective_from")
  effectiveTo     DateTime?  @map("effective_to")
  status          StatusEnum @default(active)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId, status])
  @@index([effectiveFrom, effectiveTo])
  @@index([currencyCode])
  @@map("car_pricing")
}

model CarAvailability {
  id        String                 @id @default(uuid()) @db.VarChar(36)
  carId     String                 @map("car_id") @db.VarChar(36)
  date      DateTime               @db.Date
  startTime DateTime?              @map("start_time")
  endTime   DateTime?              @map("end_time")
  status    AvailabilityStatusEnum @default(available)
  reason    String?                @db.VarChar(255)
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([carId, date])
  @@index([carId])
  @@index([date])
  @@index([status])
  @@index([date, status])
  @@map("car_availability")
}

model CarDocument {
  id                 String                 @id @default(uuid()) @db.VarChar(36)
  carId              String                 @map("car_id") @db.VarChar(36)
  documentType       String                 @map("document_type") @db.VarChar(100)
  documentUrl        String                 @map("document_url") @db.VarChar(500)
  issueDate          DateTime?              @map("issue_date") @db.Date
  expiryDate         DateTime?              @map("expiry_date") @db.Date
  verificationStatus VerificationStatusEnum @default(pending) @map("verification_status")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId])
  @@index([documentType])
  @@map("car_documents")
}

model CarInsurance {
