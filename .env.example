# ============================================================
# RentCar Backend — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env or real secrets.

# Application
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database
# Consumed by the Prisma Client generated from rentcar-database.
DATABASE_URL="mysql://USER:root@HOST:3306/rentcar"

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
# Comma-separated list of allowed origins.
# Supports development, staging and production frontend origins.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Logging
LOG_LEVEL=info

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Optional cookie domain. Leave empty for localhost/single-origin.
COOKIE_DOMAIN=

# Trusted pricing quotes (use a unique, high-entropy secret outside local development).
QUOTE_TTL_MINUTES=10
QUOTE_SIGNING_SECRET=replace_with_a_unique_high_entropy_quote_signing_secret
BOOKING_HOLD_TTL_MINUTES=15

# Razorpay payment provider (used when Phase 4B payment APIs are enabled).
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional local-development admin created by `npm run db:seed`.
# Never set real production credentials in source control.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

