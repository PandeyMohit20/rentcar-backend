# ============================================================
# RentCar Backend — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env or real secrets.

# Application
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database
# Consumed by the Prisma Client generated from rentcar-database.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/rentcar"

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
# Comma-separated list of allowed origins.
# Supports development, staging and production frontend origins.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=info

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Optional cookie domain. Leave empty for localhost/single-origin.
COOKIE_DOMAIN=

