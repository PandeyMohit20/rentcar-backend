# ============================================================
# RentCar Backend — .gitignore
# ============================================================

# Dependencies
node_modules/

# Environment — NEVER commit real secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Coverage
coverage/
test-results/
.playwright/

# Build / dist
dist/
build/
out/

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

.vercel
